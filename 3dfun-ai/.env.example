# 3DFUN AI - Environment Configuration Template
# Course Project: Group 17 · 3D Computer Vision · IIIT Dharwad

# App & Environment
APP_URL=http://localhost:8010
NODE_ENV=development
LOG_LEVEL=INFO

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Configuration (Free models & reasoning tiers)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# xAI API Configuration
XAI_API_KEY=your_xai_api_key_here

# Together AI Configuration
TOGETHER_API_KEY=your_together_api_key_here

# Fireworks AI Configuration
FIREWORKS_API_KEY=your_fireworks_api_key_here

# JWT Secrets for Student Session Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
COOKIE_SECURE=false

# Free Trial Credits & Educational Grants
CREDITS_SIGNUP_GRANT=50
DAILY_STREAK_CREDITS=10
LAB_RUN_CREDITS=10
