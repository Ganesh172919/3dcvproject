# 3DFUN AI — environment configuration
#
# The app loads .env from the project root. Process environment values take precedence.
#
# Every variable below is read by app/config.py::Settings and has a working
# development default, so an empty environment is a valid local setup.
# Never commit a real secrets file.

# --- app -------------------------------------------------------------------
NODE_ENV=development                  # development | staging | production
# APP_URL=http://127.0.0.1:8010      # set to the launch URL if overriding the launcher default

# --- auth (generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
# Production refuses to start with the dev defaults.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
ACCESS_TOKEN_TTL=900                  # seconds (15 min)
REFRESH_TOKEN_TTL=2592000             # seconds (30 days)
COOKIE_SECURE=false                   # true behind HTTPS
ALLOW_REGISTRATION=true

# --- database --------------------------------------------------------------
# SQLite by default; PostgreSQL works unchanged through SQLAlchemy:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/threefun
DATABASE_URL=sqlite:///./data/3dfun.db
REDIS_URL=                            # optional; empty = in-process queue and event log

# --- storage ---------------------------------------------------------------
STORAGE_DRIVER=local                  # local | s3
STORAGE_ROOT=./data/storage
# S3 / R2 / MinIO (only used when STORAGE_DRIVER=s3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=3dfun-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL=900                    # seconds

# --- limits ----------------------------------------------------------------
MAX_UPLOAD_MB=20
RATE_LIMIT_MAX=120                    # requests per window
RATE_LIMIT_WINDOW=60                  # seconds
LOGIN_MAX_ATTEMPTS=8
JOB_TIMEOUT_SECONDS=480               # per-job engine watchdog
JOB_CONCURRENCY=1                     # keep at 1 on a 2 GB machine

# --- generation ------------------------------------------------------------
GENERATION_PROVIDER=local             # local | http | mock
RECON_DEVICE=cpu                      # cpu | directml | cuda | auto
RECON_CUDA_MEMORY_MB=2048             # ONNX CUDA arena limit in MiB
# Generic HTTP provider (only when GENERATION_PROVIDER=http)
GENERATION_API_URL=
GENERATION_API_KEY=
GENERATION_MODEL=3dfun-recon-v1

# --- optional Gemini chat --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- credits ---------------------------------------------------------------
SIGNUP_CREDITS=60
CREDITS_DRAFT=4
CREDITS_STANDARD=8
CREDITS_HIGH=16

# --- billing / email (optional; unused paths are inert) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_dev
EMAIL_PROVIDER=console                # console | resend
RESEND_API_KEY=

# --- observability ---------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
